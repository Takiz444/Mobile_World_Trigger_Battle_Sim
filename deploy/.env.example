# Copy to deploy/.env (never commit the real one).

# Public hostname; its DNS A record must point at the server.
TT_DOMAIN=play.example.com

# Shared secret for /admin endpoints (season reset). Leave empty to disable.
# Generate one with: openssl rand -hex 32
TT_ADMIN_KEY=

# Async (correspondence) turn timer in seconds. Live matches use Ladder.LIVE_*.
TT_TURN_TIMEOUT_SEC=43200

# Store: "dir" (files on the trion-data volume) or "postgrest" (Postgres;
# also start compose with --profile postgres).
TT_STORE=dir

# Postgres only (generate with: openssl rand -hex 24).
POSTGRES_PASSWORD=
PGRST_AUTHENTICATOR_PASSWORD=
# Only if PostgREST is configured with a JWT secret.
TT_DB_TOKEN=
