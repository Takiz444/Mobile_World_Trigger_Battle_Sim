# Trion Tactics settings. Copy this file to deploy/.env (same folder) and fill
# it in. deploy/.env is git-ignored: never commit it, it holds secrets.
#
# Who reads deploy/.env:
#   - Docker:     docker compose ... --env-file deploy/.env (bootstrap.sh writes
#                 one for you with fresh random secrets on first run)
#   - Local runs: the game server (godot ... res://server/server.tscn) and the
#                 Mongo gateway (npm start / npm run dev in deploy/mongo-gateway)
#                 both read it at startup. Real environment variables win.
#   - The Oracle micro VM uses /etc/trion/trion.env instead (written by
#     deploy/native/install.sh; see deploy/README.md).

# Public hostname; its DNS A record must point at the server.
# bootstrap.sh defaults to <public-ip-with-dashes>.sslip.io (no DNS setup).
TT_DOMAIN=play.example.com

# Shared secret for /admin endpoints (season reset). Leave empty to disable.
# Must be at least 24 characters. Generate one with: openssl rand -hex 32
TT_ADMIN_KEY=

# Async (correspondence) turn timer in seconds. Live matches use Ladder.LIVE_*.
TT_TURN_TIMEOUT_SEC=43200

# --- Database -----------------------------------------------------------------
# Store: "mongo" (MongoDB; start compose with --profile mongo, or --profile
# atlas with TT_MONGO_URI below), "postgrest" (Postgres; --profile postgres),
# or "dir" (files on the trion-data volume).
TT_STORE=mongo

# Your MongoDB connection string, e.g. from Atlas (Connect -> Drivers):
#   TT_MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Leave empty to use the MongoDB inside the Docker stack ("mongo" profile).
# Characters like @ : / ? # in the password must be percent-encoded (@ -> %40).
TT_MONGO_URI=
TT_MONGO_DB=trion
# Shared secret between the game server and the Mongo gateway (any long
# random string: openssl rand -hex 32).
TT_MONGO_GATEWAY_TOKEN=
# Docker "mongo" profile only: admin password of the in-stack MongoDB.
TT_MONGO_PASSWORD=
# Local runs only: where the game server finds the gateway (Docker and the VM
# set this themselves).
TT_MONGO_GATEWAY_URL=http://127.0.0.1:8095

# --- Sign-in (Auth0) ------------------------------------------------------------
# With these set, email sign-up / sign-in, verification emails and password
# reset go through Auth0. Empty: the server keeps its own password hashes
# (fine for local development). Setup: deploy/README.md, "Auth0".
TT_AUTH0_DOMAIN=
TT_AUTH0_CLIENT_ID=
TT_AUTH0_CLIENT_SECRET=
TT_AUTH0_CONNECTION=Username-Password-Authentication

# --- Postgres only (generate with: openssl rand -hex 24) ---------------------------
POSTGRES_PASSWORD=
PGRST_AUTHENTICATOR_PASSWORD=
# Only if PostgREST is configured with a JWT secret.
TT_DB_TOKEN=
