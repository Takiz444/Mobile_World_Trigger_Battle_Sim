# TLS termination + routing for the game server. Caddy obtains and renews
# the certificate for $TT_DOMAIN automatically (the DNS A record must point
# at this host, and ports 80/443 must be open).

{$TT_DOMAIN} {
	encode gzip

	# The API only speaks JSON to the game client: no framing, no sniffing,
	# HTTPS only from now on.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Same cap as the game server (HttpServer.MAX_BODY_BYTES); oversized
	# uploads are refused here before they reach it.
	request_body {
		max_size 256KB
	}

	# Admin endpoints are never exposed publicly; call them from the host
	# (docker compose exec server ...) or over a VPN.
	@admin path /admin /admin/*
	handle @admin {
		respond "Not found" 404
	}

	# Live channel: WebSocket upgrade is proxied transparently.
	handle /live* {
		reverse_proxy server:8081
	}

	handle {
		reverse_proxy server:8080
	}
}
